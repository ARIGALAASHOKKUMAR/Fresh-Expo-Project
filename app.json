{
  "expo": {
    "name": "Mission-Haritha-Andhra",
    "slug": "Mission-Haritha-Andhra",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/512_512logo-512x512.png",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/image.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ap.forests.missionharithaandhra",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ap.forests.missionharithaandhra",
      "adaptiveIcon": {
        "foregroundImage": "./assets/512_512logo-512x512.png",
        "backgroundColor": "#E6F4FE",
        "monochromeImage": "./assets/512_512logo-512x512.png"
      }
    },
    "web": {
      "favicon": "./assets/512_512logo-512x512.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "763e7701-0abf-43ca-a080-bb85c7a2d516"
      }
    }
  }
}